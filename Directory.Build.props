<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- One version number for the whole agent. It travels to ADL on every
         call (X-Agent-Version) and is what the update feed compares against,
         so it is set once here rather than per project. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Product>ADL Agent</Product>
    <Company>WMO RAF</Company>
  </PropertyGroup>

</Project>
