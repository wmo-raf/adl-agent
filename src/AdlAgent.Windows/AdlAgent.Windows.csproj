<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AdlAgent.Windows</RootNamespace>
    <AssemblyName>adl-agent</AssemblyName>
    <Description>Windows head of the ADL Agent: Windows Service host, Windows platform providers, named-pipe control surface.</Description>
    <!-- The Windows head compiles on any OS so that the core's tests can
         exercise the real Windows providers from a Linux or macOS runner.
         Only publishing is Windows-shaped (see .github/workflows/ci.yml). -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- What `dotnet publish -r win-x64` produces: one file, with the .NET
         runtime inside it. Country servers are not machines anyone can ask
         to install a framework first, and Server 2016 is the floor this has
         to land on unaided. Applied at publish only, so an ordinary build
         stays a framework-dependent build a developer can run anywhere. -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <EnableCompressionInSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</EnableCompressionInSingleFile>
    <!-- The slate tile. The teal one next door is the product a technician
         meets; this one is worn by the service, and it exists so that the two
         entries sitting beside each other in Task Manager and Services.msc
         can be told apart at sixteen pixels, where the mark itself is a smudge
         and the colour is the only thing that still reads. Written by
         assets/render-icons.sh; see assets/README.md. -->
    <ApplicationIcon>..\..\assets\adl-agent.ico</ApplicationIcon>
    <UserSecretsId>adl-agent-windows</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Ini" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdlAgent.Core\AdlAgent.Core.csproj" />
  </ItemGroup>

</Project>
