<Window x:Class="AdlAgent.Tray.StationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Icon="adl-agent-tray.ico"
        Height="640" Width="560"
        MinHeight="420" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F6F7F9">

    <!--
        A DockPanel, and the buttons docked before anything else is declared,
        because that is what reserves them. The station editor this replaced
        was a Grid whose rows asked for more height than the tab had, and a
        Grid answers that by drawing the last row off the bottom edge: the
        Save button was there, below the window, on every screen shorter than
        the arithmetic. Docked bottom, the fields can be any height at all and
        the footer is still the last thing given room.
    -->
    <DockPanel LastChildFill="True" Margin="14">

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="0,12,0,0"
                BorderBrush="#DCE0E6" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="Save to ADL" Padding="14,6" MinWidth="110"
                            Command="{Binding SaveCommand}" />
                    <Button Content="Cancel" Padding="14,6" MinWidth="90" Margin="8,0,0,0"
                            IsCancel="True" />
                </StackPanel>

                <!--
                    Why the button beside this is grey, or what ADL said about
                    the last press of it. One or the other is always true, so
                    this line is never blank.
                -->
                <TextBlock Text="{Binding Answer}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="#33475B" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel DataContext="{Binding Station}">

                <TextBlock Foreground="#5A6472" TextWrapping="Wrap" Margin="0,0,0,4">
                    The decoder, the variable mappings and the collection start date stay in the
                    ADL admin. What is set here is where the files are and how they are named.
                </TextBlock>

                <TextBlock Style="{StaticResource Field}" Text="Local folder path" />
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Browse…" Padding="12,3"
                            Margin="8,2,0,8" VerticalAlignment="Top"
                            Click="Browse" />
                    <TextBox Style="{StaticResource Entry}"
                             Text="{Binding LocalFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <!--
                    The gap between who is browsing and who will be reading.
                    The technician picks folders as themselves; the service
                    collects as LocalSystem, which has no drive mappings and
                    reaches a share as this machine rather than as them. Both
                    mistakes come back from the count as "nothing was found in
                    this folder", which is true and sends somebody hunting for
                    a typo that is not there.
                -->
                <Border Background="#FFF4D6" BorderBrush="#E4C877" BorderThickness="1"
                        Padding="10,7" CornerRadius="3" Margin="0,0,0,8"
                        Visibility="{Binding HasLocalFolderNote, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding LocalFolderNote}" TextWrapping="Wrap" Foreground="#8A5A00" />
                </Border>

                <TextBlock Style="{StaticResource Field}" Text="File pattern" />
                <TextBox Style="{StaticResource Entry}"
                         Text="{Binding FilePattern, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Margin="0,6,0,4" Content="Files sit under dated sub-folders"
                          IsChecked="{Binding DirStructuredByDate, Mode=TwoWay}" />

                <StackPanel Visibility="{Binding DirStructuredByDate, Converter={StaticResource Visible}}">
                    <TextBlock Foreground="#6B6B6B" TextWrapping="Wrap" Margin="0,0,0,6">
                        The folders below the one above, named for the date in this station's own
                        timezone. Each cycle walks the recent ones; the daily reconciliation walks
                        the rest.
                    </TextBlock>

                    <TextBlock Style="{StaticResource Field}" Text="How far down the tree" />
                    <ComboBox Margin="0,2,0,8" HorizontalAlignment="Left" Width="200"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding DateGranularity, Mode=TwoWay}">
                        <ComboBoxItem Tag="year" Content="Year" />
                        <ComboBoxItem Tag="month" Content="Month" />
                        <ComboBoxItem Tag="day" Content="Day" />
                        <ComboBoxItem Tag="hour" Content="Hour" />
                    </ComboBox>

                    <TextBlock Style="{StaticResource Field}" Text="Month folder format" />
                    <ComboBox Margin="0,2,0,8" HorizontalAlignment="Left" Width="260"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding MonthDirFormat, Mode=TwoWay}">
                        <ComboBoxItem Tag="m" Content="01 to 12" />
                        <ComboBoxItem Tag="n" Content="1 to 12" />
                        <ComboBoxItem Tag="M" Content="Jan" />
                        <ComboBoxItem Tag="b" Content="jan" />
                        <ComboBoxItem Tag="F" Content="January" />
                        <ComboBoxItem Tag="f" Content="january" />
                    </ComboBox>
                </StackPanel>

                <TextBlock Style="{StaticResource Field}" Text="How files are found" />
                <ComboBox Margin="0,2,0,8" HorizontalAlignment="Left" Width="260"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding ListingStrategy, Mode=TwoWay}">
                    <ComboBoxItem Tag="enumerate" Content="Scan the folder (default)" />
                    <ComboBoxItem Tag="direct_fetch" Content="Build the filenames (Direct Fetch)" />
                </ComboBox>

                <!-- Only for the stations that build their filenames. -->
                <StackPanel Visibility="{Binding IsDirectFetch, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource Field}" Text="Filename prefix" />
                    <TextBox Style="{StaticResource Entry}"
                             Text="{Binding DirectFetchPrefix, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource Field}" Text="File interval (minutes)" />
                    <TextBox Style="{StaticResource Entry}" Width="120" HorizontalAlignment="Left"
                             Text="{Binding DirectFetchIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource Field}" Text="Filename datetime format" />
                    <TextBox Style="{StaticResource Entry}" Width="240" HorizontalAlignment="Left"
                             Text="{Binding DirectFetchDatetimeFormat, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource Field}" Text="Filename timezone" />
                    <TextBox Style="{StaticResource Entry}" Width="240" HorizontalAlignment="Left"
                             Text="{Binding DirectFetchDatetimeTimezone, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource Field}" Text="File extension" />
                    <TextBox Style="{StaticResource Entry}" Width="120" HorizontalAlignment="Left"
                             Text="{Binding DirectFetchFileExtension, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock Style="{StaticResource Field}"
                           Text="Leave a file alone for (seconds) after it was last written" />
                <TextBox Style="{StaticResource Entry}" Width="120" HorizontalAlignment="Left"
                         Text="{Binding StabilityWindowSeconds, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Story 7: the count, live, before anything is saved. -->
                <Border Background="#EEF3F8" BorderBrush="#CFD9E4" BorderThickness="1"
                        Padding="10,7" CornerRadius="3" Margin="0,4,0,0">
                    <TextBlock Text="{Binding MatchSummary}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
