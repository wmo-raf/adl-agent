<Window x:Class="AdlAgent.Tray.StationStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Icon="adl-agent-tray.ico"
        Height="560" Width="520"
        MinHeight="380" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F6F7F9">

    <!--
        Everything ADL holds about one station, and what is in its folder now.
        The grid behind this can hold six columns and a station has three
        times that many facts, so the ones wanted least often — the WIGOS id,
        the timezone the filenames are written in, the watermark ADL is asking
        from — were readable only by opening the settings window, which is a
        window for changing things, over a station nobody wanted to change.

        Nothing here writes, which is what makes it safe to open on a station
        a cycle is in the middle of.
    -->
    <DockPanel LastChildFill="True" Margin="14">

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="0,12,0,0"
                BorderBrush="#DCE0E6" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <!--
                        The commonest use of this window is to have it open on
                        one screen while a folder is being granted, a share
                        remounted or a file dropped in on another. Without this
                        the count is only ever as fresh as the moment the
                        window opened.
                    -->
                    <Button Content="Check again" Padding="14,6" MinWidth="110"
                            Command="{Binding CheckCommand}" />
                    <Button Content="Close" Padding="14,6" MinWidth="90" Margin="8,0,0,0"
                            IsCancel="True" />
                </StackPanel>

                <TextBlock Text="{Binding Station.StationName}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="#5A6472" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel DataContext="{Binding Station}">

                <!--
                    The count first, above everything ADL sent. Every other
                    line on this window is a memory of the last sync; this is
                    the only one that is true of this machine at the moment
                    somebody is looking at it, and "scanned 0, no error" is
                    answered by it and by nothing else.
                -->
                <Border Background="#EEF3F8" BorderBrush="#CFD9E4" BorderThickness="1"
                        Padding="10,7" CornerRadius="3" Margin="0,0,0,10">
                    <TextBlock Text="{Binding MatchSummary}" TextWrapping="Wrap" />
                </Border>

                <!--
                    Amber, and only when HQ has switched something off. The
                    folder is then not the problem and not this technician's to
                    fix, which is a sentence that has to be on the window they
                    opened to find out why nothing is arriving.
                -->
                <Border Background="#FFF4D6" BorderBrush="#E4C877" BorderThickness="1"
                        Padding="10,7" CornerRadius="3" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Standing}" TextWrapping="Wrap" Foreground="#8A5A00" />
                </Border>

                <TextBlock Style="{StaticResource Caption}" Text="Where this machine looks" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Field}" Text="Folder" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}"
                               Text="{Binding LocalFolderPath}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Field}" Text="Pattern" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}"
                               Text="{Binding FilePattern}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Field}" Text="How files are found" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}"
                               Text="{Binding ListingStrategy}" />
                </Grid>

                <TextBlock Style="{StaticResource Caption}" Text="What ADL holds" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Field}" Text="Station link ID" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}"
                               Text="{Binding StationLinkId}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Field}" Text="Station ID" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}"
                               Text="{Binding StationId}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Field}" Text="WIGOS ID" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}"
                               Text="{Binding WigosId}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Field}" Text="Connection" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}"
                               Text="{Binding ConnectionName}" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Field}" Text="Filename timezone" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}"
                               Text="{Binding Timezone}" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Field}" Text="Collecting from" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Value}"
                               Text="{Binding StartDate}" />
                    <!--
                        The oldest file ADL still wants. It is the number that
                        explains a station which is plainly working and sending
                        nothing: everything in the folder is older than this.
                    -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Field}" Text="Wants files from" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Value}"
                               Text="{Binding Watermark}" />
                    <!--
                        The number the dot on the row is the reading of, said
                        in full on the window that dot's tooltip sends people
                        to. It is also the only line in this block that is not
                        configuration: everything above is what ADL was told,
                        and this is what ADL got.
                    -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource Field}" Text="ADL last received" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Value}"
                               Text="{Binding LastReceived}" ToolTip="{Binding LastReceivedAgo}" />
                </Grid>

                <TextBlock Style="{StaticResource Caption}" Text="Last cycle" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Field}" Text="Counts" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}"
                               Text="{Binding LastCycle}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Field}" Text="Problem" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}"
                               Text="{Binding Error}" />
                </Grid>

                <!--
                    What this machine has actually been doing here, which is
                    the half of the question the probe above cannot answer. The
                    probe speaks about this instant; a station that has been
                    quietly doing nothing since Tuesday is a question about the
                    past, and until this list existed nothing on the machine
                    could answer it — the counts lived in memory and the pass
                    after overwrote them.

                    Bound to the window rather than to the station, so this
                    breaks out of the StackPanel's DataContext above.
                -->
                <StackPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}">
                    <TextBlock Style="{StaticResource Caption}" Text="Recent passes" />

                    <!--
                        A sentence and not an empty box. The empty box is the
                        thing this whole record exists to stop being the
                        answer: a machine that has genuinely not collected yet
                        and a service too old to keep a record look identical,
                        and both of them look like nothing.
                    -->
                    <TextBlock Text="{Binding PassesMessage}" TextWrapping="Wrap" Foreground="#5A6472">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPasses}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--
                        Closed to a line each, because somebody looking down
                        this list is looking for a moment — "what happened at
                        13:24" — and only then wants the files. A list that
                        showed every file of every pass would bury the moments
                        under them.
                    -->
                    <ItemsControl ItemsSource="{Binding Passes}"
                                  Visibility="{Binding HasPasses, Converter={StaticResource Visible}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,0,0,2">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding Heading}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <!--
                                                            A pass that did not
                                                            finish is the one
                                                            worth finding in a
                                                            list of forty.
                                                        -->
                                                        <DataTrigger Binding="{Binding Completed}" Value="False">
                                                            <Setter Property="Foreground" Value="#A33B2A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Expander.Header>
                                    <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True"
                                             FontFamily="Consolas" FontSize="11.5"
                                             BorderThickness="0" Background="#F2F4F7"
                                             Padding="8,6" Margin="0,4,0,6"
                                             TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto" />
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        Said out loud. Ten rows with nothing under them reads
                        as a machine that has run ten times, and on the machine
                        this happens to — a busy one — that is the opposite of
                        the truth.
                    -->
                    <TextBlock Text="Older passes than these are in this machine's log."
                               Margin="0,4,0,0" Opacity="0.75" TextWrapping="Wrap"
                               Visibility="{Binding HasMorePasses, Converter={StaticResource Visible}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
