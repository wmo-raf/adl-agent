<Window x:Class="AdlAgent.Tray.CollectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Icon="adl-agent-tray.ico"
        Height="300" Width="460"
        MinHeight="260" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F6F7F9">

    <!--
        One station being collected now, watched while it happens. The run
        belongs to the service: closing this window stops watching and does
        not stop the run, which is what Cancel is for.

        There is no progress bar and there will not be one. The agent cannot
        know how many files a folder holds until it has walked it, nor how
        many ADL will ask for until it has offered them, so a bar would be a
        number invented to fill a bar.
    -->
    <DockPanel LastChildFill="True" Margin="16">

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0" Padding="0,12,0,0"
                BorderBrush="#DCE0E6" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!--
                    Grey once the run has stopped by itself. Nothing is
                    repaired by cancelling: the agent keeps no record of what
                    it delivered, so files a stopped run did not reach are
                    offered again by the next cycle exactly as if it had never
                    run.
                -->
                <Button Content="Cancel" Padding="14,6" MinWidth="90"
                        Command="{Binding CancelCommand}" />
                <!--
                    Not IsCancel: Escape and this button both mean "stop
                    watching", and a Close that shared a key with Cancel would
                    stop the run for somebody who meant to put the window away.
                -->
                <Button Content="Close" Padding="14,6" MinWidth="90" Margin="8,0,0,0"
                        Click="CloseWindow" />
            </StackPanel>
        </Border>

        <StackPanel>
            <TextBlock Text="{Binding Station}" Foreground="#5A6472" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Binding}" Foreground="#5A6472" TextWrapping="Wrap"
                       FontFamily="Consolas" Margin="0,2,0,0" />

            <Border Background="White" BorderBrush="#DCE0E6" BorderThickness="1"
                    Padding="12,10" CornerRadius="3" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Step}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Counts}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Failures}" TextWrapping="Wrap"
                               Foreground="#5A6472" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!--
                Only when there is one. An empty red panel that is always
                there teaches somebody to stop reading the place a problem
                would appear.
            -->
            <Border Background="#FBE9E9" BorderBrush="#DFAFAF" BorderThickness="1"
                    Padding="10,7" CornerRadius="3" Margin="0,10,0,0"
                    Visibility="{Binding HasProblem, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Foreground="#8A3A3A" />
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
