<Window x:Class="AdlAgent.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADL Agent"
        Icon="adl-agent-tray.ico"
        Height="620" Width="1280"
        MinHeight="480" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7F9">

    <Window.Resources>
        <!--
            The station row's menu, here rather than inline in the row style
            below, and that is a compiler constraint rather than a preference:
            a Setter.Value inside a Style is a shared object graph with no
            namescope, so a Click written there cannot be wired to anything in
            this file. Declared as a resource of the window it belongs to, the
            handlers wire up and the one instance is shared by every row —
            which is what a context menu wants anyway, since only one is ever
            open and it acts on the selected row.
        -->
        <ContextMenu x:Key="StationRowMenu">
            <MenuItem Header="Edit settings…" Click="EditStation" />
            <MenuItem Header="Check status…" Click="CheckStation" />
            <Separator />
            <!--
                Grey when there is nothing for it to do, with the reason on
                the tooltip: switched off in ADL, or no folder bound yet. The
                service refuses either anyway — HQ can switch a station off
                between this row being drawn and the item being pressed — but
                a grey item saves the press, and a grey item with no stated
                reason is one somebody stares at.

                Read through PlacementTarget rather than off an inherited
                DataContext, because this menu is one shared instance and a
                shared menu's inherited DataContext is whichever row it was
                last attached to. The row it is being opened over is the one
                WPF puts in PlacementTarget.
            -->
            <MenuItem Header="Collect now…" Click="CollectStation"
                      ToolTipService.ShowOnDisabled="True"
                      IsEnabled="{Binding PlacementTarget.DataContext.CanCollect,
                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      ToolTip="{Binding PlacementTarget.DataContext.CollectBlockedReason,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="12">

        <!--
            The header: what this machine is, always visible. Three rows on a
            working machine — where it reports, the facts about it, and ADL's
            verdict — and fewer on every machine that has less to say, because
            each row is gated on there being something true to put in it.
        -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DCE0E6" BorderThickness="1"
                Padding="14,10" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <!--
                    The mark, so that a screenshot pasted into a support
                    thread says which program it is of. Top-aligned rather
                    than centred: the headline wraps on a narrow window and a
                    mark that drifted down the block with it would look like
                    it belonged to whichever line it ended up beside.
                -->
                <Image DockPanel.Dock="Left" Source="adl-tile.png"
                       Width="28" Height="28" VerticalAlignment="Top"
                       Margin="0,1,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel>
                    <!--
                        Three rows, and exactly one of them is ever the thing
                        the eye lands on. On a paired machine that is the
                        tinted chip at the bottom — ADL's verdict is what a
                        technician came to read — and this first row drops to
                        meta weight because an address is a reference, not
                        news. In every other state there is no verdict to draw
                        and so no chip, and the sentence here is the headline
                        and keeps the size.

                        Which is why the two are sized the way they are. This
                        row is 16px only when it is the headline; the chip is
                        13px like the facts and earns its prominence from
                        colour instead. A paired machine has no 16px row at
                        all, and that is the arrangement working rather than a
                        size somebody forgot.
                    -->
                    <TextBlock Text="{Binding Headline}" FontSize="16" TextWrapping="Wrap"
                               Visibility="{Binding ShowsHeadline,
                                                    Converter={StaticResource Visible}}" />

                    <!--
                        The address, clickable. A Hyperlink rather than a
                        TextBlock with a click handler, because that is what
                        gives it a caret-browsable, keyboard-reachable,
                        screen-reader-announced link — and the technician who
                        needs this row most is the one on somebody else's
                        machine with somebody else's settings.

                        Slate and not the #1B6AC9 the Quiet button uses, which
                        is the one other clickable-looking text in this
                        program. The two differ on purpose: that one is an
                        action inside the window and wants to be found, this
                        one is a reference that leaves it, sitting in a row of
                        meta text that nothing else in should draw an eye. The
                        permanent underline is what says "clickable" here, not
                        the colour.
                    -->
                    <TextBlock Foreground="#5A6472" TextWrapping="Wrap" FontSize="13"
                               Visibility="{Binding ShowsPairedTo,
                                                    Converter={StaticResource Visible}}"><!--
                        --><Run Text="Paired to" /><Run Text=" " /><Hyperlink
                            NavigateUri="{Binding AdlLink, Mode=OneWay}"
                            RequestNavigate="OpenAdl"
                            Foreground="#33475B"
                            TextDecorations="Underline"
                            ToolTip="Open this ADL in a browser"><Run
                                Text="{Binding AdlUrl, Mode=OneWay}" /></Hyperlink></TextBlock>

                    <!--
                        The facts, one line each and laid side by side so the
                        strip reads as a single line whenever it fits: glyph,
                        label, value, and for the two moments how long ago it
                        was.

                        A WrapPanel and not a fixed row: at the window's 900px
                        minimum the five do not fit, and the choice was between
                        wrapping and silently clipping the last one off the
                        right edge. Because each fact is a TextBlock of its own
                        and none of them sets TextWrapping, the break lands
                        between two facts and never inside one — which is what
                        the single wrapping sentence this replaced got wrong.

                        The glyph is a run in that text rather than an element
                        beside it, and aligns by BaselineAlignment Center —
                        see the Glyph style, which is where the reasoning for
                        that lives.

                        Version is not gated. It is this machine's own fact,
                        true from the moment the service answers, and it is the
                        first thing HQ asks for down a telephone. The other
                        four are ADL's and appear only once ADL has said
                        something — see ShellViewModel.ShowsAdlFacts.

                        The parentheses around the relative are inside the
                        string the view model serves, not runs here: a Run
                        cannot be hidden — it is not an element — so a machine
                        ADL has never beaten for would be left showing an empty
                        pair of them.
                    -->
                    <WrapPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Fact}"
                                   Visibility="{Binding ShowsAdlFacts,
                                                        Converter={StaticResource Visible}}"><Run
                            Style="{StaticResource Glyph}" Text="&#xE977;" /><Run
                            Style="{StaticResource FactLabel}" Text="  Device: " /><Run
                            Style="{StaticResource FactValue}"
                            Text="{Binding DeviceName, Mode=OneWay}" /></TextBlock>

                        <TextBlock Style="{StaticResource Fact}"><Run
                            Style="{StaticResource Glyph}" Text="&#xE946;" /><Run
                            Style="{StaticResource FactLabel}" Text="  Version: " /><Run
                            Style="{StaticResource FactValue}"
                            Text="{Binding AgentVersion, Mode=OneWay}" /></TextBlock>

                        <TextBlock Style="{StaticResource Fact}"
                                   Visibility="{Binding ShowsAdlFacts,
                                                        Converter={StaticResource Visible}}"><Run
                            Style="{StaticResource Glyph}" Text="&#xE95E;" /><Run
                            Style="{StaticResource FactLabel}" Text="  Last heartbeat: " /><Run
                            Style="{StaticResource FactValue}"
                            Text="{Binding LastHeartbeat, Mode=OneWay}" /><Run Text=" " /><Run
                            Style="{StaticResource FactAgo}"
                            Text="{Binding LastHeartbeatAgo, Mode=OneWay}" /></TextBlock>

                        <TextBlock Style="{StaticResource Fact}"
                                   Visibility="{Binding ShowsAdlFacts,
                                                        Converter={StaticResource Visible}}"><Run
                            Style="{StaticResource Glyph}" Text="&#xE895;" /><Run
                            Style="{StaticResource FactLabel}" Text="  Last synced: " /><Run
                            Style="{StaticResource FactValue}"
                            Text="{Binding LastSynced, Mode=OneWay}" /><Run Text=" " /><Run
                            Style="{StaticResource FactAgo}"
                            Text="{Binding LastSyncedAgo, Mode=OneWay}" /></TextBlock>

                        <!--
                            No colon on this one. The other four read as
                            "label: value"; this one's value is already a
                            phrase, and "Scans: every 2 minutes" is a colon
                            followed by "every".
                        -->
                        <TextBlock Style="{StaticResource Fact}"
                                   Visibility="{Binding ShowsAdlFacts,
                                                        Converter={StaticResource Visible}}"><Run
                            Style="{StaticResource Glyph}" Text="&#xE823;" /><Run
                            Style="{StaticResource FactLabel}" Text="  Scans " /><Run
                            Style="{StaticResource FactValue}"
                            Text="{Binding CheckInterval, Mode=OneWay}" /></TextBlock>

                        <!--
                            The one live fact in this header, and the only one
                            that is not there most of the time: a settled
                            machine is between passes and shows nothing, which
                            is what keeps this worth looking at when it does
                            appear.

                            It is here because everything else on this screen
                            is a stale count or a cadence, and a machine
                            working through a backlog spends hours uploading
                            while all of them sit still. Somebody looking at
                            that could not tell it from a machine that had
                            stopped — see wmo-raf/adl#304.

                            No colon, for the same reason as Scans above it:
                            the value is already a phrase.
                        -->
                        <TextBlock Style="{StaticResource Fact}"
                                   Visibility="{Binding Collecting,
                                                        Converter={StaticResource Visible}}"><Run
                            Style="{StaticResource Glyph}" Text="&#xE896;" /><Run
                            Style="{StaticResource FactLabel}" Text="  Now " /><Run
                            Style="{StaticResource FactValue}"
                            Text="{Binding CollectingNow, Mode=OneWay}" /></TextBlock>
                    </WrapPanel>

                    <!--
                        ADL's verdict, as a chip: shaped like the facts above
                        it — same glyph, same label, same sizes — but on a
                        tinted ground, which is what makes it the one thing in
                        this header a technician's eye lands on. Font weight
                        used to do that job and does not any more; the header
                        has no 16px row at all on a paired machine.

                        Sized to its own text rather than the width of the
                        card, so that it reads as a badge about one fact
                        instead of a third band across the window.

                        The same four colours as the connection list, the tray
                        icon and the next-step band, from the same TrayState —
                        see ShellViewModel.FleetTone.

                        Which means this chip and that band can show different
                        colours ten pixels apart, and that is the truth rather
                        than a mistake: this one is ADL's opinion of whether
                        the machine is reporting in, and the band below is
                        whether anything wants a person. A green chip over an
                        amber band is a machine ADL can hear perfectly well
                        that still has a station needing a folder.

                        Paired machines only. A revoked machine's last verdict
                        is from before ADL cut it off, and a green chip reading
                        "Collecting and sending" under a sentence saying
                        nothing is being sent is a contradiction the screen
                        should not be able to draw. Its heartbeat and sync
                        times stay above, which is what that machine actually
                        needs.
                    -->
                    <Border Margin="0,8,0,0" HorizontalAlignment="Left"
                            BorderThickness="1" CornerRadius="4" Padding="8,4"
                            Visibility="{Binding ShowsPairedTo,
                                                 Converter={StaticResource Visible}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- Amber by default, matching the dot inside
                                     it and the band below: the states that are
                                     not asking for somebody say so. -->
                                <Setter Property="Background" Value="#FFF4D6" />
                                <Setter Property="BorderBrush" Value="#E4C877" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FleetTone}" Value="Working">
                                        <Setter Property="Background" Value="#E9F5EC" />
                                        <Setter Property="BorderBrush" Value="#A9CDB4" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FleetTone}" Value="Stopped">
                                        <Setter Property="Background" Value="#FBE9E9" />
                                        <Setter Property="BorderBrush" Value="#DFAFAF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FleetTone}" Value="Unknown">
                                        <Setter Property="Background" Value="#EFF1F3" />
                                        <Setter Property="BorderBrush" Value="#CFD5DB" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <!--
                            One line of text holding all four things, so that
                            the glyph, the words and the dot are placed by one
                            layout rather than three aligned to each other by
                            hand. Both symbols take BaselineAlignment Center —
                            the middle of the text, which WPF measures from the
                            font itself.

                            The dot rides in the flow as an InlineUIContainer
                            rather than sitting beside the text as a sibling,
                            which is what it did while it looked low: as a
                            sibling it could only centre on the line box, and a
                            line box carries descender space the eye does not
                            see. An Ellipse and not a bullet character, because
                            9px is 9px whatever font a machine falls back to.

                            The dot is inside the value rather than on the
                            label, because the colour is part of the answer.
                            It stays even though the chip behind it is the same
                            hue — a pale wash reads as decoration and a
                            saturated dot reads as a state, which is why status
                            badges are drawn this way.
                        -->
                        <TextBlock Style="{StaticResource FactText}"><Run
                            Style="{StaticResource Glyph}" Text="&#xEC05;" /><Run
                            Style="{StaticResource FactLabel}"
                            Text="  Status: " /><InlineUIContainer
                                BaselineAlignment="Center"><Ellipse
                                    Width="9" Height="9" Margin="0,0,5,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#E4B93C" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FleetTone}" Value="Working">
                                                <Setter Property="Fill" Value="#5FA773" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FleetTone}" Value="Stopped">
                                                <Setter Property="Fill" Value="#C46B6B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FleetTone}" Value="Unknown">
                                                <Setter Property="Fill" Value="#B4BCC4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse></InlineUIContainer><Run
                            Style="{StaticResource FactValue}"
                            Text="{Binding FleetStatus, Mode=OneWay}" /></TextBlock>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--
            The next step: what to do now and who has to do it, always there,
            above every tab. Not a banner that appears when something is
            wrong — a machine with nothing to do says so, because "nothing"
            is an answer a technician came here for and an empty space is
            not.
        -->
        <Border DockPanel.Dock="Top" Margin="0,10,0,0" BorderThickness="1"
                Padding="14,10" CornerRadius="4">
            <Border.Style>
                <Style TargetType="Border">
                    <!-- Amber is the default because most of these states want
                         somebody; the two that do not say so explicitly. -->
                    <Setter Property="Background" Value="#FFF4D6" />
                    <Setter Property="BorderBrush" Value="#E4C877" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NextStep.Attention}" Value="Working">
                            <Setter Property="Background" Value="#E9F5EC" />
                            <Setter Property="BorderBrush" Value="#A9CDB4" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NextStep.Attention}" Value="Stopped">
                            <Setter Property="Background" Value="#FBE9E9" />
                            <Setter Property="BorderBrush" Value="#DFAFAF" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NextStep.Attention}" Value="Unknown">
                            <Setter Property="Background" Value="#EFF1F3" />
                            <Setter Property="BorderBrush" Value="#CFD5DB" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding NextStep.Text}" TextWrapping="Wrap" />
        </Border>

        <!-- The answer to the last button pressed. -->
        <TextBlock DockPanel.Dock="Bottom" Margin="2,10,2,0" Foreground="#33475B"
                   TextWrapping="Wrap" Text="{Binding Message}" />

        <TabControl Margin="0,10,0,0" Background="White"
                    SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">

            <!-- ============ Stations (stories 6, 7, 9) ============ -->
            <!--
                Greyed out until this machine has paired, because until then
                what is behind it is one sentence and a tab that looks like a
                working one is a tab somebody clicks during the five minutes
                when the only thing to do is on the other one. Which states,
                and why RePairNeeded is not one of them, is TrayTabs.Available.

                ShowOnDisabled, or the tooltip is the one thing here that
                silently does nothing: a disabled TabItem does not raise the
                mouse events a tooltip is shown from, so the explanation for
                why a control cannot be used would be readable only on the
                control when it can.
            -->
            <TabItem Header="Stations" IsEnabled="{Binding StationsAvailable}"
                     ToolTipService.ShowOnDisabled="True"
                     ToolTip="Available once this machine is paired with ADL.">
                <!--
                    Two panes: the connections ADL has given this machine, and
                    the stations under the one selected. Split because a
                    connection had nowhere to be a thing rather than a repeated
                    value in a column — so a connection switched off in ADL was
                    indistinguishable from its stations each being switched off,
                    and a connection with no stations linked to it yet did not
                    appear at all.

                    The settings themselves are in a window of their own: they
                    were in a row beneath this grid, under a fixed-height
                    scroll area, and between them the two asked for more height
                    than this tab has — so the Save button below them was drawn
                    off the bottom edge and could only be reached by making the
                    window bigger.
                -->
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="90" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!--
                            Fixed, and no GridSplitter. A splitter's position
                            is state nobody persists, and on a window that
                            hides rather than closes it silently keeps whatever
                            it was last dragged to for the rest of the session
                            — which is how a station list ends up 40 pixels
                            wide with nothing on screen explaining why.
                        -->
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        Across both panes, and only when there is nothing in
                        either. A device an administrator has not linked
                        anything to yet, an ADL that is not answering and a
                        service that is not running all used to draw the same
                        nothing — three problems, three different people to go
                        and find, one blank rectangle.
                    -->
                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10"
                            Padding="12,9" CornerRadius="3"
                            Background="#EEF3F8" BorderBrush="#CFD9E4" BorderThickness="1"
                            Visibility="{Binding ShowsMachineReason, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding NoStationsReason}" TextWrapping="Wrap" />
                    </Border>

                    <!-- The connections ADL has given this machine. -->
                    <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" LastChildFill="True">

                        <!--
                            The pane is named, told what it is for, and given
                            the one button that acts on the whole of it. It was
                            a bare list against the left edge, which is a
                            control with no label on a window whose whole
                            manner is to say the quiet thing out loud.

                            A strip rather than three loose things above a
                            list: a title, a button and a caption floating on
                            the page ground read as three unrelated items that
                            happen to be stacked, and the button in particular
                            looked like it belonged to whatever was above it.
                            Tinted, bordered on three sides, and flush against
                            the list below — whose own top border is the line
                            between them — so the strip and the list are one
                            panel with a head on it.
                        -->
                        <Border DockPanel.Dock="Top" Background="#EEF1F4"
                                BorderBrush="#DCE0E6" BorderThickness="1,1,1,0"
                                CornerRadius="3,3,0,0" Padding="10,7">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <!--
                                        Machine-wide, and so here rather than
                                        repeated down the rows: ADL's sync
                                        serves this device's whole
                                        configuration in one answer, and a
                                        Refresh on each connection would
                                        promise a scope it does not have.

                                        It asks for the configuration and
                                        nothing else — no scan, no upload.
                                        "What is this machine meant to be
                                        doing" and "do it now" are different
                                        questions with different waits, and the
                                        second one is on the station rows.
                                    -->
                                    <Button DockPanel.Dock="Right" Content="Sync with ADL"
                                            Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                            ToolTip="Ask ADL for this machine's configuration now"
                                            Command="{Binding SyncCommand}" />
                                    <TextBlock Text="Connections" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <!--
                                    Until somebody picks one, and then never
                                    again. The pane is a master list beside a
                                    detail grid, which is an idiom — but it is
                                    one this window did not have until
                                    recently, and the person it was split for
                                    opens it once, on a country server, having
                                    been told to on the telephone.

                                    Inside the strip, under the name of the
                                    thing it is explaining. Below it, on the
                                    page ground, it read as a caption for the
                                    list rather than as part of its heading —
                                    and left a gap behind when it went.
                                -->
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="#5A6472" FontSize="11" TextWrapping="Wrap"
                                           Text="Click one to see its linked stations."
                                           Visibility="{Binding ShowsConnectionHint, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </Border>

                        <ListBox BorderBrush="#DCE0E6" BorderThickness="1"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemsSource="{Binding Connections}"
                                 SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                                 PreviewKeyDown="ConnectionKeyed">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            The same three colours the tray icon
                                            and the next-step band use, from the
                                            same TrayState. A row that invented a
                                            fourth would be a fourth vocabulary to
                                            learn.
                                        -->
                                        <Ellipse Grid.Column="0" Width="8" Height="8"
                                                 VerticalAlignment="Top" Margin="0,5,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#E4B93C" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Attention}" Value="Working">
                                                            <Setter Property="Fill" Value="#5FA773" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Attention}" Value="Stopped">
                                                            <Setter Property="Fill" Value="#C46B6B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Attention}" Value="Unknown">
                                                            <Setter Property="Fill" Value="#B4BCC4" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding ConnectionName}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Foreground="#5A6472" FontSize="11" Margin="0,1,0,0"
                                                       TextWrapping="Wrap">
                                                <Run Text="{Binding StationCount, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Standing, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- The stations under the connection selected on the left. -->
                    <DockPanel Grid.Row="1" Grid.Column="1" LastChildFill="True">

                        <!--
                            What this grid is a list of. The Connection column
                            was removed when the pane on the left arrived —
                            every row here is by definition from the connection
                            selected there — and that left the grid's scope
                            stated nowhere but by a highlight in another
                            control. Which is how somebody reads the wrong
                            vendor's stations and does not know they have.

                            The same strip as the connection pane's, for the
                            same reason and so that the two panes are the same
                            kind of thing: a headed panel each, rather than one
                            headed panel beside a line of text above a grid.
                        -->
                        <Border DockPanel.Dock="Top" Background="#EEF1F4"
                                BorderBrush="#DCE0E6" BorderThickness="1,1,1,0"
                                CornerRadius="3,3,0,0" Padding="10,7"
                                Visibility="{Binding HasSelectedConnection, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding StationsHeading}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Grid>
                            <DataGrid x:Name="StationGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#EDEFF2" RowHeight="32"
                                      SelectionMode="Single" BorderBrush="#DCE0E6" BorderThickness="1"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ItemsSource="{Binding SelectedConnection.Stations}"
                                      SelectedItem="{Binding SelectedStation, Mode=TwoWay}"
                                      PreviewKeyDown="StationKeyed">
                                <!--
                                    The rule between rows is lighter than the
                                    #DCE0E6 frame around them on purpose: the frame
                                    is the edge of the control and the rules are
                                    only there to keep the eye on one station's
                                    line. When they were the same weight the grid
                                    read as a table of boxes rather than a list.
                                -->
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="10,7" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <!--
                                                        The stock cell template has
                                                        no Padding in it at all, so
                                                        the property above would be
                                                        set and ignored. This is the
                                                        whole of the change: a
                                                        border that honours it.
                                                    -->
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter VerticalAlignment="Center"
                                                                          SnapsToDevicePixels="True" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.CellStyle>
                                <!--
                                    Double-click opens the station, on the row
                                    rather than on the grid: the grid's own
                                    double-clicks include the column headers, where
                                    opening whatever happened to be selected would
                                    be a window nobody asked for.

                                    The right-click handler is not a second way of
                                    opening anything. WPF does not select a row on
                                    the right button, so without it the menu below
                                    would appear over the row under the pointer and
                                    act on whichever row happened to be selected
                                    before — which is a mistake nobody would see
                                    themselves make.
                                -->
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <EventSetter Event="MouseDoubleClick" Handler="StationActivated" />
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="StationRightClicked" />
                                        <Setter Property="ContextMenu" Value="{StaticResource StationRowMenu}" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <!--
                                        No Connection column: every row here is by
                                        definition from the connection selected on
                                        the left, so it would be 130 pixels
                                        repeating the selection back. Folder is the
                                        column that gets them, being the one thing
                                        on this tab the technician actually owns.

                                        Folder and Pattern stay side by side
                                        deliberately: "scanned 0, no error" almost
                                        always means the glob does not match what is
                                        in that folder, and reading the two together
                                        is how somebody sees it. Last cycle is the
                                        other half of the same diagnosis.

                                        Every column sizes to its content between a
                                        floor and a ceiling, and none of them is
                                        starred. A starred column always shrinks to
                                        fit the window, which is what made the grid
                                        unable to overflow — and so unable to
                                        scroll — and a problem message is exactly
                                        the value that has no useful maximum length.
                                        The ceilings are there so one pathological
                                        path or one long refusal from ADL cannot
                                        push everything else off the right-hand
                                        edge.
                                    -->
                                    <!--
                                        The number a support conversation is
                                        conducted in. Leftmost and named "Link ID"
                                        rather than "ID" because the row already
                                        carries another identifier — the station's
                                        own, the one a vendor's filenames usually
                                        have in them — and the two are quoted at
                                        each other over the telephone.
                                    -->
                                    <!--
                                        Whether anything is actually reaching
                                        ADL for this station, which is the one
                                        question the rest of the row cannot
                                        answer: every other column is about
                                        what this machine did, and all of it
                                        reads healthy for a station that is
                                        configured perfectly and sending
                                        nothing.

                                        Leftmost because it is the column that
                                        decides whether the others are worth
                                        reading, and headed rather than bare —
                                        a coloured dot under a blank header is
                                        a thing people guess at. The reason is
                                        on the tooltip for the same reason it
                                        is on the greyed-out menu item.

                                        The same four marks as the connection
                                        pane's dot, and deliberately so: green
                                        and amber mean here what they mean
                                        three hundred pixels to the left. Grey
                                        is the absence of a verdict rather than
                                        a fourth one — a station switched off
                                        in ADL is not collecting, is not
                                        failing, and is nobody's to fix.
                                    -->
                                    <DataGridTemplateColumn Header="Status" Width="Auto" MinWidth="54"
                                                            SortMemberPath="Flow">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="9" Height="9"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         ToolTip="{Binding FlowReason}">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#5FA773" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Flow}" Value="Quiet">
                                                                    <Setter Property="Fill" Value="#E4B93C" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Flow}" Value="Blocked">
                                                                    <Setter Property="Fill" Value="#C46B6B" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Flow}" Value="NotJudged">
                                                                    <Setter Property="Fill" Value="#B4BCC4" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Link ID" Width="Auto" MinWidth="64"
                                                        Binding="{Binding StationLinkId}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Station" Width="Auto" MinWidth="120" MaxWidth="220"
                                                        Binding="{Binding StationName}" />
                                    <DataGridTextColumn Header="Folder" Width="Auto" MinWidth="160" MaxWidth="420"
                                                        Binding="{Binding LocalFolderPath}" />
                                    <DataGridTextColumn Header="Pattern" Width="Auto" MinWidth="100" MaxWidth="220"
                                                        Binding="{Binding FilePattern}" />
                                    <!--
                                        ADL's record, not this machine's, and
                                        named for it: "collected" is what the
                                        agent does every cycle, and a column
                                        called that beside "Last cycle" would
                                        read as two facts about this machine
                                        when one of them is ADL's.

                                        Absolute, and in the machine's own
                                        timezone like every other moment here.
                                        The age is on the tooltip, where it is
                                        rebuilt as it opens — a relative string
                                        in the cell would be as fresh as the
                                        poll that wrote it and no fresher.
                                    -->
                                    <DataGridTextColumn Header="ADL last received" Width="Auto"
                                                        MinWidth="130" MaxWidth="200"
                                                        Binding="{Binding LastReceived}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding LastReceivedAgo}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Last cycle" Width="Auto" MinWidth="130" MaxWidth="260"
                                                        Binding="{Binding LastCycle}" />
                                    <DataGridTextColumn Header="Problem" Width="Auto" MinWidth="160" MaxWidth="600"
                                                        Binding="{Binding Error}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!--
                                Over the grid rather than above it, and about this
                                connection rather than about the machine. "ADL has
                                linked nothing to this connection" and "this
                                connection is switched off in ADL" are two
                                different problems wanting two different people,
                                and neither is a fact about the list on the left.
                            -->
                            <Border Background="White" Padding="14,11" Margin="1"
                                    Visibility="{Binding ShowsConnectionReason, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding SelectedConnection.NoStationsReason}"
                                           TextWrapping="Wrap" VerticalAlignment="Top"
                                           Foreground="#33475B" />
                            </Border>
                        </Grid>
                    </DockPanel>

                </Grid>
            </TabItem>

            <!-- ============ Status (stories 23, 27) ============ -->
            <TabItem Header="Status">
                <StackPanel Margin="16" HorizontalAlignment="Left" Grid.IsSharedSizeScope="True">

                    <!--
                        What this program is, above what this machine is
                        doing. There is no About box and this is why: the tab
                        somebody opens to answer "what is this server
                        running" is this one, and a version living in two
                        places is a version that can disagree with itself.
                        The "This version" row that used to sit in the grid
                        below is this line now.
                    -->
                    <StackPanel Orientation="Horizontal">
                        <Image Source="adl-tile.png" Width="44" Height="44"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                <Run Text="ADL Agent" /><Run Text=" " /><Run Text="{Binding AgentVersion, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="WMO RAF" Foreground="#5A6472" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Separator Margin="0,14,0,4" Background="#DCE0E6" />

                    <!--
                        Two grids and not one, sharing a label column so they
                        read as a single list. The first is what this machine
                        is on its own; the second is what ADL has told it, and
                        is not drawn at all until ADL has told it something.
                        A server on its first morning used to answer "what is
                        this machine?" with six dashes and a blank row.
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="StatusLabel" />
                            <ColumnDefinition Width="*" MinWidth="320" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Field}" Text="ADL" />
                        <!--
                            The address, and underneath it, only when there is not
                            one, what the person reading this can do about it.
                            Beneath the address rather than in a row of its own
                            because that is where somebody looks when they want to
                            know where this machine reports, and an empty row
                            there is what used to look like a service that had
                            stopped answering.
                        -->
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <!--
                                The address and the way to change it on one
                                line, in the shape the Pairing row below
                                already has: a state, and the quietest
                                possible way to act on it. Beside rather than
                                beneath, because beneath would sit between the
                                address and the hint that explains it on the
                                one machine that has a hint.

                                Offered on every machine the service has
                                answered for, including one whose technician
                                has no administrator rights: the consent
                                prompt behind it is exactly where an
                                administrator standing beside them types a
                                password, which is how these visits actually
                                go. Hiding it from the person the window is
                                for would be the worse of the two mistakes;
                                the other is pretending the change worked.
                            -->
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Value}" Text="{Binding AdlUrl}" />
                                <TextBlock Text="  ·  " Opacity="0.75" Style="{StaticResource Value}"
                                           Visibility="{Binding ShowsChangeAdl, Converter={StaticResource Visible}}" />
                                <Button Content="Change…" Style="{StaticResource Quiet}"
                                        VerticalAlignment="Center" Click="ChangeAdl"
                                        Visibility="{Binding ShowsChangeAdl, Converter={StaticResource Visible}}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding ConfigurationHint}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" Opacity="0.75"
                                       Visibility="{Binding NeedsConfiguring, Converter={StaticResource Visible}}" />
                        </StackPanel>

                        <!--
                            ADL's, and so hidden with the rest of ADL's until
                            there is one — but kept here rather than moved down
                            into the second grid, so that the order a paired
                            machine reads in is the order it has always read in.
                        -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Field}" Text="Device"
                                   Visibility="{Binding HasEverPaired, Converter={StaticResource Visible}}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding DeviceName}"
                                   Visibility="{Binding HasEverPaired, Converter={StaticResource Visible}}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Field}" Text="Pairing" />
                        <!--
                            The tab this used to be. A code box a machine uses
                            once had the leftmost tab of the window to itself,
                            beside a copy of four facts this page already
                            carried — so a technician on a server that paired
                            months ago was shown a screen with nothing on it to
                            do, and the one thing it was for was somewhere else
                            from the row that says whether it is needed.

                            Here it is the row: the state, the moment it began,
                            and the remedy underneath it — which is the shape
                            the ADL row above already has, so the page has one
                            rule rather than two.
                        -->
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Style="{StaticResource Value}" Text="{Binding PairingLine}" />

                            <!--
                                The history and the way back to a code box, on
                                one line and in the quietest thing on the page.
                                A machine that is working has nothing to do
                                here on all but a handful of days in its life —
                                but ADL rotates a code without revoking the
                                token it replaces, deliberately, so a machine
                                being rotated never asks for anything and
                                whoever is holding that code needs somewhere to
                                put it.
                            -->
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding PairedSince}" Opacity="0.75"
                                           Visibility="{Binding HasEverPaired, Converter={StaticResource Visible}}" />
                                <TextBlock Text="  ·  " Opacity="0.75"
                                           Visibility="{Binding ShowsPairAgain, Converter={StaticResource Visible}}" />
                                <Button Content="Pair again…" Style="{StaticResource Quiet}" Click="PairAgain"
                                        Visibility="{Binding ShowsPairAgain, Converter={StaticResource Visible}}" />
                            </StackPanel>

                            <!--
                                One sentence and not the four this had as a tab
                                of its own. The line at the top of every tab
                                already says to paste the code and that nothing
                                else needs setting up; what it cannot say, and
                                what somebody typing a credential into a
                                ministry's server wants to know, is what
                                happens to it afterwards.
                            -->
                            <StackPanel Margin="0,8,0,0" MaxWidth="420"
                                        Visibility="{Binding ShowsPairingBox, Converter={StaticResource Visible}}">
                                <TextBlock TextWrapping="Wrap" Foreground="#5A6472"
                                           Text="No password is ever stored on this machine." />
                                <TextBlock Style="{StaticResource Caption}" Text="Pairing code" />
                                <TextBox Style="{StaticResource Entry}" FontFamily="Consolas" FontSize="16"
                                         Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}" />
                                <!--
                                    Cancel only where there is something to
                                    cancel to. On a machine that has never
                                    paired, or one ADL has revoked, this box
                                    is the page — but the window hides rather
                                    than closes, so a box opened by mistake on
                                    a working machine would still be standing
                                    open tomorrow.
                                -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Pair this machine" Padding="14,6"
                                            Command="{Binding PairCommand}" />
                                    <Button Content="Cancel" Padding="14,6" Margin="8,0,0,0"
                                            Click="CancelPairAgain"
                                            Visibility="{Binding ShowsCancelPairing, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!--
                        Everything ADL supplies, gated on ADL having ever
                        admitted this machine — and deliberately not on its
                        being paired now. A machine revoked this morning wants
                        its last heartbeat, its last sync and its last problem
                        on screen more than at any other time in its life.
                    -->
                    <Grid Visibility="{Binding HasEverPaired, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="StatusLabel" />
                            <ColumnDefinition Width="*" MinWidth="320" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Field}" Text="ADL says" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding FleetStatus}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Field}" Text="Last heartbeat" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding LastHeartbeat}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Field}" Text="Last synced" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding LastSynced}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Field}" Text="Configuration version" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding ConfigVersion}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Field}" Text="Clock difference" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding ClockSkew}" />
                        <!--
                            The cadence nothing else on this screen would
                            reveal. A deployment-wide setting moves no
                            configuration version, so a machine whose sweeps
                            were switched off centrally looks identical to one
                            sweeping nightly — until a technician wonders why
                            a file backfilled last week never went.
                        -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Field}" Text="Reconciles" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Reconciles}" />
                        <!--
                            What this machine is doing about its version. The
                            number itself is in the block above; this is the half
                            that changes, and the alternative, when HQ says a
                            country is running something old, is a technician
                            reading service logs to find out whether their machine
                            is pinned, unable to reach the feed, or simply already
                            current.
                        -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Field}" Text="Updates" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding UpdateStatus}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource Field}" Text="Last problem" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding LastError}" />
                    </Grid>
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
