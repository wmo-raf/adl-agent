<Window x:Class="AdlAgent.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADL Agent"
        Icon="adl-agent-tray.ico"
        Height="620" Width="1100"
        MinHeight="480" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7F9">

    <DockPanel LastChildFill="True" Margin="12">

        <!-- The header: what this machine is, in one line, always visible. -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DCE0E6" BorderThickness="1"
                Padding="14,10" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <!--
                    The mark, so that a screenshot pasted into a support
                    thread says which program it is of. Top-aligned rather
                    than centred: the headline wraps on a narrow window and a
                    mark that drifted down the block with it would look like
                    it belonged to whichever line it ended up beside.
                -->
                <Image DockPanel.Dock="Left" Source="adl-tile.png"
                       Width="28" Height="28" VerticalAlignment="Top"
                       Margin="0,1,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel>
                    <TextBlock Text="{Binding Headline}" FontSize="14" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Foreground="#5A6472" TextWrapping="Wrap">
                        <Run Text="Agent" /><Run Text=" " /><Run Text="{Binding AgentVersion, Mode=OneWay}" />
                        <Run Text="  ·  last heartbeat " /><Run Text="{Binding LastHeartbeat, Mode=OneWay}" />
                        <Run Text="  ·  last synced " /><Run Text="{Binding LastSynced, Mode=OneWay}" />
                        <Run Text="  ·  scans " /><Run Text="{Binding CheckInterval, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--
            The next step: what to do now and who has to do it, always there,
            above every tab. Not a banner that appears when something is
            wrong — a machine with nothing to do says so, because "nothing"
            is an answer a technician came here for and an empty space is
            not.
        -->
        <Border DockPanel.Dock="Top" Margin="0,10,0,0" BorderThickness="1"
                Padding="14,10" CornerRadius="4">
            <Border.Style>
                <Style TargetType="Border">
                    <!-- Amber is the default because most of these states want
                         somebody; the two that do not say so explicitly. -->
                    <Setter Property="Background" Value="#FFF4D6" />
                    <Setter Property="BorderBrush" Value="#E4C877" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NextStep.Attention}" Value="Working">
                            <Setter Property="Background" Value="#E9F5EC" />
                            <Setter Property="BorderBrush" Value="#A9CDB4" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NextStep.Attention}" Value="Stopped">
                            <Setter Property="Background" Value="#FBE9E9" />
                            <Setter Property="BorderBrush" Value="#DFAFAF" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NextStep.Attention}" Value="Unknown">
                            <Setter Property="Background" Value="#EFF1F3" />
                            <Setter Property="BorderBrush" Value="#CFD5DB" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding NextStep.Text}" TextWrapping="Wrap" />
        </Border>

        <!-- The answer to the last button pressed. -->
        <TextBlock DockPanel.Dock="Bottom" Margin="2,10,2,0" Foreground="#33475B"
                   TextWrapping="Wrap" Text="{Binding Message}" />

        <TabControl Margin="0,10,0,0" Background="White"
                    SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">

            <!-- ============ Pairing (story 2) ============ -->
            <TabItem Header="Pairing">
                <StackPanel Margin="16" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock TextWrapping="Wrap" Foreground="#5A6472">
                        Your ADL administrator creates this machine in the ADL admin and gives you a
                        pairing code. Paste it here. Nothing else about ADL needs setting up on this
                        machine, and no password is ever stored on it.
                    </TextBlock>

                    <TextBlock Style="{StaticResource Caption}" Text="Pairing code" />
                    <TextBox Style="{StaticResource Entry}" FontFamily="Consolas" FontSize="16"
                             Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="Pair this machine" HorizontalAlignment="Left" Padding="14,6"
                            Command="{Binding PairCommand}" />

                    <TextBlock Style="{StaticResource Caption}" Text="This machine" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Field}" Text="ADL" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding AdlUrl}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Field}" Text="State" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding PairingState}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Field}" Text="Device" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding DeviceName}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Field}" Text="Paired" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding PairedAt}" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- ============ Stations (stories 6, 7, 9) ============ -->
            <TabItem Header="Stations">
                <!--
                    Two panes: the connections ADL has given this machine, and
                    the stations under the one selected. Split because a
                    connection had nowhere to be a thing rather than a repeated
                    value in a column — so a connection switched off in ADL was
                    indistinguishable from its stations each being switched off,
                    and a connection with no stations linked to it yet did not
                    appear at all.

                    The settings themselves are in a window of their own: they
                    were in a row beneath this grid, under a fixed-height
                    scroll area, and between them the two asked for more height
                    than this tab has — so the Save button below them was drawn
                    off the bottom edge and could only be reached by making the
                    window bigger.
                -->
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="90" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!--
                            Fixed, and no GridSplitter. A splitter's position
                            is state nobody persists, and on a window that
                            hides rather than closes it silently keeps whatever
                            it was last dragged to for the rest of the session
                            — which is how a station list ends up 40 pixels
                            wide with nothing on screen explaining why.
                        -->
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        Across both panes, and only when there is nothing in
                        either. A device an administrator has not linked
                        anything to yet, an ADL that is not answering and a
                        service that is not running all used to draw the same
                        nothing — three problems, three different people to go
                        and find, one blank rectangle.
                    -->
                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10"
                            Padding="12,9" CornerRadius="3"
                            Background="#EEF3F8" BorderBrush="#CFD9E4" BorderThickness="1"
                            Visibility="{Binding ShowsMachineReason, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding NoStationsReason}" TextWrapping="Wrap" />
                    </Border>

                    <!-- The connections ADL has given this machine. -->
                    <ListBox Grid.Row="1" Grid.Column="0" Margin="0,0,12,0"
                             BorderBrush="#DCE0E6" BorderThickness="1"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding Connections}"
                             SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                             PreviewKeyDown="ConnectionKeyed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--
                                        The same three colours the tray icon
                                        and the next-step band use, from the
                                        same TrayState. A row that invented a
                                        fourth would be a fourth vocabulary to
                                        learn.
                                    -->
                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             VerticalAlignment="Top" Margin="0,5,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#E4B93C" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Attention}" Value="Working">
                                                        <Setter Property="Fill" Value="#5FA773" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Attention}" Value="Stopped">
                                                        <Setter Property="Fill" Value="#C46B6B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Attention}" Value="Unknown">
                                                        <Setter Property="Fill" Value="#B4BCC4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ConnectionName}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Foreground="#5A6472" FontSize="11" Margin="0,1,0,0"
                                                   TextWrapping="Wrap">
                                            <Run Text="{Binding StationCount, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Standing, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- The stations under the connection selected on the left. -->
                    <Grid Grid.Row="1" Grid.Column="1">
                        <DataGrid x:Name="StationGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  SelectionMode="Single" BorderBrush="#DCE0E6" BorderThickness="1"
                                  ItemsSource="{Binding SelectedConnection.Stations}"
                                  SelectedItem="{Binding SelectedStation, Mode=TwoWay}"
                                  PreviewKeyDown="StationKeyed">
                            <!--
                                Double-click opens the station, on the row
                                rather than on the grid: the grid's own
                                double-clicks include the column headers, where
                                opening whatever happened to be selected would
                                be a window nobody asked for.
                            -->
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <EventSetter Event="MouseDoubleClick" Handler="StationActivated" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!--
                                    No Connection column: every row here is by
                                    definition from the connection selected on
                                    the left, so it would be 130 pixels
                                    repeating the selection back. Folder is the
                                    column that gets them, being the one thing
                                    on this tab the technician actually owns.

                                    Folder and Pattern stay side by side
                                    deliberately: "scanned 0, no error" almost
                                    always means the glob does not match what is
                                    in that folder, and reading the two together
                                    is how somebody sees it. Last cycle is the
                                    other half of the same diagnosis.
                                -->
                                <DataGridTextColumn Header="Station" Width="130" Binding="{Binding StationName}" />
                                <DataGridTextColumn Header="Folder" Width="*" MinWidth="150" Binding="{Binding LocalFolderPath}" />
                                <DataGridTextColumn Header="Pattern" Width="120" Binding="{Binding FilePattern}" />
                                <DataGridTextColumn Header="Last cycle" Width="120" Binding="{Binding LastCycle}" />
                                <DataGridTextColumn Header="Problem" Width="160" Binding="{Binding Error}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!--
                            Over the grid rather than above it, and about this
                            connection rather than about the machine. "ADL has
                            linked nothing to this connection" and "this
                            connection is switched off in ADL" are two
                            different problems wanting two different people,
                            and neither is a fact about the list on the left.
                        -->
                        <Border Background="White" Padding="14,11" Margin="1"
                                Visibility="{Binding ShowsConnectionReason, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding SelectedConnection.NoStationsReason}"
                                       TextWrapping="Wrap" VerticalAlignment="Top"
                                       Foreground="#33475B" />
                        </Border>
                    </Grid>

                    <!--
                        The one action a selected row has, named. A row that
                        opens on a double-click and says so nowhere is a row
                        whose settings a technician on a country server does
                        not find at all.
                    -->
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Edit settings…" Padding="14,6"
                                IsEnabled="{Binding HasSelectedStation}"
                                Click="EditStation" />
                    </StackPanel>

                </Grid>
            </TabItem>

            <!-- ============ Status (stories 23, 27) ============ -->
            <TabItem Header="Status">
                <StackPanel Margin="16" HorizontalAlignment="Left">

                    <!--
                        What this program is, above what this machine is
                        doing. There is no About box and this is why: the tab
                        somebody opens to answer "what is this server
                        running" is this one, and a version living in two
                        places is a version that can disagree with itself.
                        The "This version" row that used to sit in the grid
                        below is this line now.
                    -->
                    <StackPanel Orientation="Horizontal">
                        <Image Source="adl-tile.png" Width="44" Height="44"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                <Run Text="ADL Agent" /><Run Text=" " /><Run Text="{Binding AgentVersion, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="WMO RAF" Foreground="#5A6472" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Separator Margin="0,14,0,4" Background="#DCE0E6" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="320" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Field}" Text="ADL" />
                        <!--
                            The address, and underneath it, only when there is not
                            one, what the person reading this can do about it.
                            Beneath the address rather than in a row of its own
                            because that is where somebody looks when they want to
                            know where this machine reports, and an empty row
                            there is what used to look like a service that had
                            stopped answering.
                        -->
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Style="{StaticResource Value}" Text="{Binding AdlUrl}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding ConfigurationHint}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" Opacity="0.75"
                                       Visibility="{Binding NeedsConfiguring, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Field}" Text="Device" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding DeviceName}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Field}" Text="Pairing" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding PairingState}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Field}" Text="ADL says" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding FleetStatus}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Field}" Text="Last heartbeat" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding LastHeartbeat}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Field}" Text="Last synced" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding LastSynced}" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Field}" Text="Configuration version" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding ConfigVersion}" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource Field}" Text="Clock difference" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding ClockSkew}" />
                        <!--
                            What this machine is doing about its version. The
                            number itself is in the block above; this is the half
                            that changes, and the alternative, when HQ says a
                            country is running something old, is a technician
                            reading service logs to find out whether their machine
                            is pinned, unable to reach the feed, or simply already
                            current.
                        -->
                        <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource Field}" Text="Updates" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding UpdateStatus}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource Field}" Text="Last problem" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding LastError}" />

                        <Button Grid.Row="10" Grid.Column="1" Content="Refresh now" Padding="14,6"
                                HorizontalAlignment="Left" Margin="0,14,0,0"
                                Command="{Binding RefreshCommand}" />
                    </Grid>
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
